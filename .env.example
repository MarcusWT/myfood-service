PORT=3000
DB_PATH=./data/myfood.db
SPOONACULAR_API_KEY=your_api_key_here
EXPIRY_ALERT_DEFAULT_DAYS=7
NOTIFICATION_POLL_INTERVAL_MS=3600000
NOTIFICATION_WITHIN_DAYS=7
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=24h
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10
RECIPE_RATE_LIMIT_MAX=20
BODY_LIMIT=100kb
# Comma-separated list of allowed CORS origins (e.g. https://app.example.com,https://admin.example.com).
# Defaults to "*" (allow any origin) for dev convenience only; set explicitly in shared/production environments.
CORS_ORIGIN=*
# Express "trust proxy" setting. Leave as "false" when running directly (no reverse proxy).
# Set to the number of hops to trust (e.g. "1") when behind a reverse proxy/load balancer,
# so the rate limiter sees the real client IP instead of the proxy's IP.
TRUST_PROXY=false
